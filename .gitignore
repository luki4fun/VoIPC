/target
/release
*.swp
*.swo
*~

# IDE
.idea/
.vscode/
*.iml

# Tauri client build artifacts
client/src-tauri/target/
client/src-tauri/external-dlls/
client/src-tauri/appimage-libs/
client/node_modules/
client/dist/

# Web client build artifacts (npm run build:web)
client/dist-web/
client/src/lib/wasm/

# Written by every build (tools/tasks/notices.mjs); Vite copies it into the
# bundles, where About links to it
client/public/THIRD-PARTY-NOTICES.txt

# Tauri rewrites its capability schemas on every build
client/src-tauri/gen/schemas/

# `tauri icon` also writes sets VoIPC never ships: iOS, the Windows Store (the
# Windows build is NSIS) and a copy of the launcher icons gen/android/ holds
client/src-tauri/icons/ios/
client/src-tauri/icons/android/
client/src-tauri/icons/Square*Logo.png
client/src-tauri/icons/StoreLogo.png

# Impeccable's review renders are regenerated by every design review; the
# surface briefs in .impeccable/surfaces/ are the record and stay tracked
.impeccable/review/

# Certificates (keep generate script, ignore actual certs)
certs/*.key
certs/*.crt
certs/*.pem

# Android release signing — passwords and the signing key itself.
# Losing the key means no future update can install over an existing app;
# leaking it means anyone can publish an update. Keep the .example only.
keystore.properties
*.jks
*.keystore

# OS files
.DS_Store
Thumbs.db

# Android release signing — passwords and the signing key itself.
# Losing the key means no future update can install over an existing app;
# leaking it means anyone can publish an update. Keep the .example only.
keystore.properties
*.jks
*.keystore

# OS files
.DS_Store
Thumbs.db

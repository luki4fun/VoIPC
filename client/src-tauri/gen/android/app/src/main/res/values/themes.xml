<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme.

         The window is drawn edge to edge and the app paints its own background
         into the status- and navigation-bar strips (the shell pads its content
         out of them with env(safe-area-inset-*)). So the bars themselves are
         transparent and Android's contrast scrim is switched off — without
         that, the navigation bar is an opaque band in the system's colour
         across the bottom of a dark app.

         The icons are the light set, which is right for three of the four
         palettes VoIPC ships and for the default. Following the chosen palette
         exactly would need a native call on every palette change; this is the
         static approximation. -->
    <style name="Theme.voipc_client" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:enforceStatusBarContrast" tools:targetApi="q">false</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="q">false</item>
    </style>

    <!-- The splash Android shows before any app code runs, for the next start
         (Android 13+): MainActivity picks the one for the palette in use, so a
         dark palette on a phone in light mode no longer opens on white. One per
         palette, the colour only. -->
    <style name="Theme.voipc_client.Launch.voipc_night" parent="Theme.voipc_client">
        <item name="android:windowBackground">@color/launch_voipc_night</item>
    </style>
    <style name="Theme.voipc_client.Launch.voipc_day" parent="Theme.voipc_client">
        <item name="android:windowBackground">@color/launch_voipc_day</item>
    </style>
    <style name="Theme.voipc_client.Launch.voipc_dark" parent="Theme.voipc_client">
        <item name="android:windowBackground">@color/launch_voipc_dark</item>
    </style>
    <style name="Theme.voipc_client.Launch.slate_dark" parent="Theme.voipc_client">
        <item name="android:windowBackground">@color/launch_slate_dark</item>
    </style>
    <style name="Theme.voipc_client.Launch.slate_light" parent="Theme.voipc_client">
        <item name="android:windowBackground">@color/launch_slate_light</item>
    </style>
    <style name="Theme.voipc_client.Launch.amoled" parent="Theme.voipc_client">
        <item name="android:windowBackground">@color/launch_amoled</item>
    </style>
</resources>

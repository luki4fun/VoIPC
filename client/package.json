{
  "name": "voipc-client",
  "private": true,
  "version": "1.0.0-rc.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "build:wasm": "node ../tools/voipc.mjs build:wasm && npm run build:opus",
    "build:opus": "cargo build --manifest-path ../crates/voipc-opus-wasm/Cargo.toml --target wasm32-unknown-unknown --release --locked --target-dir ../target/opus-wasm && node -e \"require('fs').copyFileSync('../target/opus-wasm/wasm32-unknown-unknown/release/voipc_opus_wasm.wasm', 'src/lib/wasm/voipc_opus.wasm')\"",
    "build:web": "npm run build:wasm && vite build --mode web",
    "dev:web": "vite --mode web",
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test 'src/**/*.test.ts'"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-notification": "^2.4.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5",
    "@tauri-apps/cli": "^2",
    "svelte": "^5",
    "svelte-check": "4.7.7",
    "typescript": "^5",
    "vite": "^6"
  }
}
